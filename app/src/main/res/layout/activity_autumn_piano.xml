<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF7EA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:paddingEnd="24dp"
            android:text="@string/autumn_back"
            android:textColor="#553D33"
            android:textSize="17sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/autumn_title"
            android:textColor="#3B2B2A"
            android:textSize="30sp"
            android:textStyle="bold" />

        <Button android:id="@+id/btnFallingNotes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/autumn_falling_notes" />

        <TextView
            android:id="@+id/tvPracticeGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/autumn_practice_guide"
            android:textColor="#6D574A"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/autumn_subtitle"
            android:textColor="#665651"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSheet"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/autumn_open_sheet" />

            <Button
                android:id="@+id/btnVideo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/autumn_watch_video" />
        </LinearLayout>

        <Button
            android:id="@+id/btnReferenceSheet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/autumn_reference_sheet" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/autumn_sheet_note"
            android:textColor="#736660"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_autumn_practice_card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#916A50"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvChord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textColor="#473028"
                android:textSize="48sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="#5A4034"
                android:textSize="18sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/autumn_how_to_play"
                android:textColor="#736660"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnPrevious"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/autumn_previous" />

            <Button
                android:id="@+id/btnPlayPattern"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="5dp"
                android:layout_weight="1.4"
                android:text="@string/autumn_play_pattern" />

            <Button
                android:id="@+id/btnNext"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/autumn_next" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/autumn_keyboard"
            android:textColor="#3B2B2A"
            android:textSize="20sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnSustain"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/autumn_sustain_off" />

        <com.xylophone.learning.music.activity_app.main.PlayablePianoKeyboard
            android:id="@+id/playKeyboard"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:layout_marginTop="10dp"
            android:background="#FFF7EA" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button android:id="@+id/keyC" style="@style/AutumnPianoKey" android:text="C3" />
                <Button android:id="@+id/keyD" style="@style/AutumnPianoKey" android:text="D3" />
                <Button android:id="@+id/keyE" style="@style/AutumnPianoKey" android:text="E3" />
                <Button android:id="@+id/keyF" style="@style/AutumnPianoKey" android:text="F3" />
                <Button android:id="@+id/keyG" style="@style/AutumnPianoKey" android:text="G3" />
                <Button android:id="@+id/keyA" style="@style/AutumnPianoKey" android:text="A3" />
                <Button android:id="@+id/keyB" style="@style/AutumnPianoKey" android:text="B3" />
                <Button android:id="@+id/keyC4" style="@style/AutumnPianoKey" android:text="C4" />
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>
</ScrollView>
